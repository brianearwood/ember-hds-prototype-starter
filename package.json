{
  "name": "ember-hds-prototype",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Reusable Ember prototype starter with the Helios Design System",
  "repository": "",
  "license": "MIT",
  "author": "",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.{css,scss}\"",
    "lint:css:fix": "stylelint \"**/*.{css,scss}\" --fix",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\"",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "start": "vite",
    "test": "concurrently \"npm:lint\" \"npm:test:*\" --names \"lint,test:\"",
    "test:ember": "vite build --mode development && ember test --path dist"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@ember/app-tsconfig": "^1.0.3",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.0",
    "@ember/test-helpers": "^5.8.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/compat": "^4.1.28",
    "@embroider/config-meta-loader": "^1.0.1",
    "@embroider/core": "^4.6.10",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.21.1",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.8.1",
    "@glimmer/component": "^2.2.1",
    "@glint/ember-tsc": "^1.14.4",
    "@glint/template": "^1.7.7",
    "@glint/tsserver-plugin": "^2.7.17",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/qunit": "^2.19.10",
    "@types/rsvp": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-plugin-ember-template-compilation": "^3.1.0",
    "concurrently": "^8.2.2",
    "decorator-transforms": "^2.4.0",
    "ember-cli": "~6.12.0",
    "ember-cli-babel": "^8.3.2",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.1.0",
    "ember-qunit": "^9.2.1",
    "ember-resolver": "^13.2.0",
    "ember-source": "~6.12.1",
    "ember-template-lint": "^6.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-ember": "^12.2.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-qunit": "^8.1.2",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.3.3",
    "qunit": "^2.22.0",
    "qunit-dom": "^3.2.1",
    "sass": "^1.104.0",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-prettier": "^4.1.0",
    "testem": "^3.21.0",
    "tracked-built-ins": "^4.1.2",
    "typescript": "^5.6.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@hashicorp/design-system-components": "^7.1.0",
    "@hashicorp/design-system-tokens": "^6.0.1",
    "@hashicorp/flight-icons": "^5.3.0",
    "ember-basic-dropdown": "^8.9.0",
    "ember-intl": "^8.0.0"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "ember": {
    "edition": "octane"
  }
}
